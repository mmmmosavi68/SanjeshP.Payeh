{
  "ConnectionStrings": {
    "SqlServer": "Server=.;DataBase=SanjeshP_Payeh;Integrated Security=true;TrustServerCertificate=Yes"
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "SiteSettings": {
    "ElmahPath": "/elmah-errors",
    "JwtSettings": {
      "SecretKey": "__SET_VIA_USER_SECRETS_OR_ENV__",
      "EncryptKey": "__SET_VIA_ENV__",
      "Issuer": "SanjeshP.Payeh",
      "Audience": "SanjeshP.Payeh",
      "NotBeforeMinutes": "0",
      "ExpirationMinutes": "15"
    },
    "IdentitySettings": {
      "PasswordRequireDigit": "true",
      "PasswordRequiredLength": "8",
      "PasswordRequireNonAlphanumeric": "false",
      "PasswordRequireUppercase": "false",
      "PasswordRequireLowercase": "false",
      "RequireUniqueEmail": "true"
    },
    "AllowMultipleSessions": true,
    "OtpSettings": {
      "CodeLength": 6,
      "ExpirationSeconds": 120,
      "ResendIntervalSeconds": 120,
      "MaxAttempts": 5,
      "ReturnCodeInResponse": false
    },
    "CaptchaSettings": {
      "Enabled": false,
      "Provider": "Recaptcha",
      "SecretKey": "",
      "VerifyUrl": "https://www.google.com/recaptcha/api/siteverify"
    },
    "SmsSettings": {
      "Provider": "Mock"
    },
    "RefreshTokenSettings": {
      "ExpirationDays": 7
    },
    "ApiDocsSettings": {
      "Enabled": false,
      "Path": "/scalar"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    {
                      "Name": "ByExcluding",
                      "Args": { "expression": "Audit = true" }
                    }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/app-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 30
                      }
                    }
                  ]
                }
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    {
                      "Name": "ByIncludingOnly",
                      "Args": { "expression": "Audit = true" }
                    }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/audit-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 365
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}